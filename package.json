{
    "name": "atlas",
    "version": "1.0.0",
    "private": true,
    "description": "Atlas \u2014 a production-ready project management platform (projects, tasks, assignment, collaboration, analytics)",
    "license": "MIT",
    "engines": {
        "node": ">=20.11"
    },
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace @atlas/api & npm run dev --workspace @atlas/web",
        "build": "npm run build --workspace @atlas/api && npm run build --workspace @atlas/web",
        "start": "node apps/api/dist/index.js",
        "test": "npm run test --workspace @atlas/api",
        "test:watch": "npm run test:watch --workspace @atlas/api",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "smoke": "node scripts/smoke.mjs",
        "smoke:web": "node scripts/smoke-web.mjs",
        "db:sqlite": "node scripts/use-db.mjs sqlite && npm run prisma:push --workspace @atlas/api",
        "db:postgres": "node scripts/use-db.mjs postgres",
        "db:seed": "npm run prisma:seed --workspace @atlas/api",
        "db:generate": "npm run prisma:generate --workspace @atlas/api"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.0.0",
        "globals": "^17.14.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.72.1"
    }
}