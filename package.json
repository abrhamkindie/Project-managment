{
  "name": "orbita",
  "version": "1.0.0",
  "private": true,
  "description": "Orbita — a production-ready project management platform (projects, tasks, assignment, collaboration, analytics)",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @orbita/api & npm run dev --workspace @orbita/web",
    "build": "npm run build --workspace @orbita/api && npm run build --workspace @orbita/web",
    "start": "node apps/api/dist/index.js",
    "test": "npm run test --workspace @orbita/api",
    "test:watch": "npm run test:watch --workspace @orbita/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "db:sqlite": "node scripts/use-db.mjs sqlite && npm run prisma:push --workspace @orbita/api",
    "db:postgres": "node scripts/use-db.mjs postgres",
    "db:seed": "npm run prisma:seed --workspace @orbita/api",
    "db:generate": "npm run prisma:generate --workspace @orbita/api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  }
}
