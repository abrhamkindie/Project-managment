# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# ---------------------------------------------------------------- database
# Local development / tests use SQLite (zero infrastructure):
DATABASE_URL="file:./dev.db"
# Production uses PostgreSQL (same schema, see scripts/use-db.mjs):
# DATABASE_URL="postgresql://zorqen:zorqen@localhost:5432/zorqen?schema=public"

# ---------------------------------------------------------------- auth
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------- web/CORS
WEB_URL=http://localhost:3000
# Comma separated list of origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------------------------------------------------------------- uploads
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# S3_BUCKET=zorqen-uploads
# S3_REGION=eu-central-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# ---------------------------------------------------------------- mail
# console | smtp
MAIL_DRIVER=console
MAIL_FROM="ZORQEN <no-reply@zorqen.local>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ---------------------------------------------------------------- jobs / limits
# Set to false on horizontally-scaled replicas that should not run cron jobs.
CRON_ENABLED=true
DUE_REMINDER_CRON=0 8 * * *
HOUSEKEEPING_CRON=30 3 * * *
RECURRENCE_CRON=15 * * * *
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
