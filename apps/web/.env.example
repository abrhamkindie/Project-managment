# --------------------------------------------------------------- browser <-> web
# The browser only ever calls the web origin; Next proxies these paths to the API
# (see next.config.mjs), so session cookies stay first-party.
NEXT_PUBLIC_API_PREFIX=/api/v1

# -------------------------------------------------------------- web -> API (server side)
# Used by the proxy rewrites and by server components that fetch on their own.
API_SERVER_URL=http://127.0.0.1:4000

# ------------------------------------------------------ realtime (optional override)
# Leave empty to use the same-origin /realtime proxy. Set an absolute URL only when the
# socket cannot be proxied (for example a separate api.<host> without a shared path).
NEXT_PUBLIC_REALTIME_URL=
